{
  "name": "dsh-comfyui-agent",
  "version": "0.1.1",
  "private": true,
  "description": "DeepSeek Harness 的 ComfyUI 插件：Agent 直接驱动本地 ComfyUI 跑用户保存的画布工作流、内置 txt2img/img2img 模板，出图直接回显在对话里",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
